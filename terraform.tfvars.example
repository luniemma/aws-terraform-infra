################################################################################
# Example variable values — copy to terraform.tfvars and customise
################################################################################

# General
aws_region   = "us-east-1"
project_name = "myapp"
environment  = "dev"

# Network
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]
enable_nat_gateway   = false   # set to true if instances are in private subnets

# Security — replace with your actual public IP
allowed_ssh_cidrs = ["203.0.113.10/32"]
public_key_path   = "~/.ssh/id_rsa.pub"   # leave "" to skip key pair

# EC2
instance_type        = "t3.micro"
ami_id               = ""       # leave "" to use latest Amazon Linux 2023
instance_count       = 1
ec2_in_public_subnet = true
assign_eip           = false    # set to true for a stable public IP

# Storage
root_volume_size = 20
root_volume_type = "gp3"
additional_ebs_volumes = [
  # { device_name = "/dev/xvdb", volume_size = 50, volume_type = "gp3" }
]

# Monitoring
enable_detailed_monitoring = false
cpu_alarm_threshold        = 80
alarm_sns_topic_arn        = ""  # e.g. "arn:aws:sns:us-east-1:123456789012:my-alerts"
